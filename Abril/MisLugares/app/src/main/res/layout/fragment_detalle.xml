<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".DetalleFragment">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:layout_marginEnd="168dp"
                android:text="Mi Lugar Nuevo" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imagenD"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:scaleType="centerCrop"
                    android:layout_margin="8dp"/>

                <ImageView
                    android:id="@+id/icD"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:scaleType="centerInside"
                    android:layout_margin="8dp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/nombreD"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:text="prueba"/>

            <TextView
                android:id="@+id/direccionD"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:text="prueba"/>

            <TextView
                android:id="@+id/webD"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:text="prueba"/>

            <TextView
                android:id="@+id/telefonoD"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:text="prueba"/>

            <TextView
                android:id="@+id/descripcionD"
                android:layout_width="293dp"
                android:layout_height="124dp"
                android:gravity="center_vertical"
                android:text="prueba">

            </TextView>


            <ImageView
                android:id="@+id/tipoLugarD"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

            </ImageView>

            <RatingBar
                android:id="@+id/calificacionD"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:isIndicator="true"
                />
            <TextView
                android:id="@+id/fechaHoraD"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="prueba"
                android:gravity="center_vertical"/>



        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>